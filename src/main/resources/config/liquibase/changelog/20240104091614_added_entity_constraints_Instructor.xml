<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        Added the constraints for entity Instructor.
    -->
    <changeSet id="20240104091614-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="gender_id"
                                 baseTableName="instructor"
                                 constraintName="fk_instructor__gender_id"
                                 referencedColumnNames="id"
                                 referencedTableName="app_config"
                                 />

        <addForeignKeyConstraint baseColumnNames="instructor_id"
                                 baseTableName="rel_instructor__course"
                                 constraintName="fk_rel_instructor__course__instructor_id"
                                 referencedColumnNames="id"
                                 referencedTableName="instructor"
                                 />

        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="rel_instructor__course"
                                 constraintName="fk_rel_instructor__course__course_id"
                                 referencedColumnNames="id"
                                 referencedTableName="course"
                                 />
    </changeSet>
</databaseChangeLog>
