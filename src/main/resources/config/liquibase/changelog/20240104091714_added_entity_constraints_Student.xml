<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        Added the constraints for entity Student.
    -->
    <changeSet id="20240104091714-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="gender_id"
                                 baseTableName="student"
                                 constraintName="fk_student__gender_id"
                                 referencedColumnNames="id"
                                 referencedTableName="app_config"
                                 />

        <addForeignKeyConstraint baseColumnNames="student_id"
                                 baseTableName="rel_student__course"
                                 constraintName="fk_rel_student__course__student_id"
                                 referencedColumnNames="id"
                                 referencedTableName="student"
                                 />

        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="rel_student__course"
                                 constraintName="fk_rel_student__course__course_id"
                                 referencedColumnNames="id"
                                 referencedTableName="course"
                                 />
    </changeSet>
</databaseChangeLog>
