    <!--
        Added the constraints for entity Payments.
    -->
    <changeSet id="20260831015044-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="method_id"
                                 baseTableName="payments"
                                 constraintName="fk_payments__method_id"
