<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity ClassSchedule.
    -->
    <changeSet id="20260831015039-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="gradelevel_id"
                                 baseTableName="class_schedule"
                                 constraintName="fk_class_schedule__gradelevel_id"
                                 referencedColumnNames="id"
                                 referencedTableName="app_config"
                                 />

        <addForeignKeyConstraint baseColumnNames="terms_id"
                                 baseTableName="class_schedule"
                                 constraintName="fk_class_schedule__terms_id"
                                 referencedColumnNames="id"
                                 referencedTableName="academic_terms"
                                 />

        <addForeignKeyConstraint baseColumnNames="year_id"
                                 baseTableName="class_schedule"
                                 constraintName="fk_class_schedule__year_id"
                                 referencedColumnNames="id"
                                 referencedTableName="academic_year"
                                 />
    </changeSet>
</databaseChangeLog>
