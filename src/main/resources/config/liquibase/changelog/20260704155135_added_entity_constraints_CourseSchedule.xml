<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity CourseSchedule.
    -->
    <changeSet id="20260704155135-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="terms_id"
                                 baseTableName="course_schedule"
                                 constraintName="fk_course_schedule__terms_id"
                                 referencedColumnNames="id"
                                 referencedTableName="academic_terms"
                                 />

        <addForeignKeyConstraint baseColumnNames="year_id"
                                 baseTableName="course_schedule"
                                 constraintName="fk_course_schedule__year_id"
                                 referencedColumnNames="id"
                                 referencedTableName="academic_year"
                                 />

        <addForeignKeyConstraint baseColumnNames="instructor_id"
                                 baseTableName="course_schedule"
                                 constraintName="fk_course_schedule__instructor_id"
                                 referencedColumnNames="id"
                                 referencedTableName="instructor"
                                 />

        <addForeignKeyConstraint baseColumnNames="student_id"
                                 baseTableName="course_schedule"
                                 constraintName="fk_course_schedule__student_id"
                                 referencedColumnNames="id"
                                 referencedTableName="student"
                                 />
    </changeSet>
</databaseChangeLog>
