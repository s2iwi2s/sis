// jdbc:postgresql://ubuntu.vm:5432/SchInfoSys?ssl=require
// jdbc:postgresql://pg-db-s2iwi2s-a12a.a.aivencloud.com:14536/defaultdb?ssl=require&user=avnadmin

application {
  config {
    baseName SchInfoSys
    applicationType monolith,
    packageName com.sis
    authenticationType jwt
    prodDatabaseType postgresql
    devDatabaseType postgresql
    buildTool maven
    clientFramework angular
  }
  entities *
}

entity Org{
    name String,
    logo String,
    address String,
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity Instructor {
	firstName String,
	middleName String,
	lastName String,
	email String,
	phoneNumber String,
	hireDate Instant,
	salary Long,
	commissionPct Long,
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity Student {
    lrn String,
    firstName String maxlength(50),
    middleName String maxlength(50),
    lastName String maxlength(50),
    extName String maxlength(10),
    birthDate Instant,
    birthPlace String maxlength(50),
    contactNo String maxlength(12),
    address1 String maxlength(200),
    address2 String maxlength(200),
    city String maxlength(50),
    zipCode String maxlength(10),
    country String maxlength(50),
    nationality String maxlength(100),
    motherTongue String maxlength(50),
    religion String maxlength(100),
    fathersLastName String maxlength(50),
    fathersMiddleName String maxlength(50),
    fathersFirstName String maxlength(50),
    fathersExtName String maxlength(50),
    fathersOccupation String maxlength(50),
    fathersContacts String maxlength(50),
    mothersLastName String maxlength(50),
    mothersMiddleName String maxlength(50),   
    mothersFirstName String maxlength(50),
    mothersOccupation String maxlength(50),
    mothersContacts String maxlength(50),
    guardianFullName String maxlength(50), 
    guardianContacts String maxlength(50)
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity Course {
	subject String maxlength(50),
	hoursPerQuarter Long,
	courseDescription TextBlob,
	courseObjectives TextBlob
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity AppConfig {
	code String,
    value String,
 	description String,
    json TextBlob,
	priority Integer
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity CurriculumMap {
	quarterNo Integer,
	weekNo Integer,
	topic String,
	contentStandards String,
	performanceStandards String
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity LearningCompetency {
	seqNo Integer,
	competencyCode String maxlength(50),
	description String
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity Strategies {
	name String,
	description String
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity Assessment {
	name String,
	instruction String,
	markScheme TextBlob
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

entity Resources {
	fileName String maxlength(50),
	fileNameOnServer String,
    document AnyBlob
    createdDate ZonedDateTime,
    lastModifiedDate ZonedDateTime
}

relationship OneToOne {
  Org{currSchYr} to AppConfig
  Student{gender} to AppConfig
  Instructor{gender} to AppConfig
  //Course{schYr} to AppConfig
  Course{gradelevel} to AppConfig
}

relationship ManyToMany {
    Instructor{course} to Course
    Student{course} to Course
    
	Strategies{resources} to Resources
	Assessment{resources} to Resources
}

relationship ManyToOne {
    Org{createdBy} to User with builtInEntity
    Org{lastModifiedBy} to User with builtInEntity
    AppConfig{createdBy} to User with builtInEntity
    AppConfig{lastModifiedBy} to User with builtInEntity
    Instructor{createdBy} to User with builtInEntity
    Instructor{lastModifiedBy} to User with builtInEntity
    Student{createdBy} to User with builtInEntity
    Student{lastModifiedBy} to User with builtInEntity
    Course{createdBy} to User with builtInEntity
    Course{lastModifiedBy} to User with builtInEntity
    CurriculumMap{createdBy} to User with builtInEntity
    CurriculumMap{lastModifiedBy} to User with builtInEntity
    LearningCompetency{createdBy} to User with builtInEntity
    LearningCompetency{lastModifiedBy} to User with builtInEntity
    Strategies{createdBy} to User with builtInEntity
    Strategies{lastModifiedBy} to User with builtInEntity
    Assessment{createdBy} to User with builtInEntity
    Assessment{lastModifiedBy} to User with builtInEntity
}

relationship OneToMany {
	Course{curriculumMap} to CurriculumMap
	CurriculumMap{learningCompetency} to LearningCompetency
    LearningCompetency{strategies} to Strategies
    LearningCompetency{assessment} to Assessment
}

// paginate Org, Instructor, Student, Course, AppConfig, CurriculumMap, LearningCompetency, Strategies, Assessment, Resources with pagination
// dto * with mapstruct
// service all with serviceImpl

use mapstruct, serviceImpl, pagination for *